        }
      ]
    },
    {
      "id": "claim_a961d5e07e5c465c81ab68253e1ddc42",
      "statement": "The tray menu is backed by three application-level Gio.SimpleActions - show, toggle-sync, and quit - where show presents the window, toggle-sync forwards to main_window._on_sync_toggle, and quit sets _quitting and quits.",
