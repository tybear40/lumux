  "claims": [
    {
      "id": "claim_e0e18d1885354c93b4edcc85c79d453e",
      "statement": "SettingsManager is a hand-rolled singleton (__new__ creates the instance once and runs _init, which builds a fresh Settings aggregate, resolves the config directory, and loads settings.json); is_running_in_flatpak detects the sandbox via /.flatpak-info or FLATPAK_ID, and inside Flatpak the config dir is $XDG_CONFIG_HOME/lumux (portable to ~/.var/app/io.github.enginkirmaci.lumux/config/lumux), otherwise ~/.config/lumux.",
      "evidence": [
        {
          "resource": "repo://src/lumux/config/settings_manager.py#L15-L117",
          "version": "repo-lines-v1:sha256:2524847f62632080d3e524d4dcf948ca96047a5916f331288c3b6e98f4f2973a:"
        }
      ]
    },
    {
      "id": "claim_71322c1ce58846eeb66423db801be2e7",
      "statement": "The Settings aggregate holds seven typed sections with these defaults: hue (empty bridge_ip/app_key/client_key/entertainment_config_id, auto_discover true), capture (scale_factor 0.125, source_type 'screen', empty restore_token), zones (show_preview true, 16 rows, 16 cols), sync (fps 30, transition 50 ms, brightness_scale 1.0, gamma 1.0, smoothing 0.3), ui (all false), black_bar (disabled, threshold 10, rate 30, smooth 0.3), reading_mode (color_xy (0.5, 0.4), brightness 150, auto_activate true, auto_activate_on_startup false, empty light_ids).",
      "evidence": [
        {
          "resource": "repo://src/lumux/config/settings_manager.py#L20-L89",
          "version": "repo-lines-v1:sha256:9a0e1c2f04350efd88fc16d5896a96f5595cebd43a1d2c216cca17312cd05083:"
        }
      ]
    },
    {
      "id": "claim_7418c9f25aa2444ba1577c520fd7919c",
      "statement": "data/default_settings.json mirrors the dataclass defaults and is installed to share/lumux/data per pyproject, but no Python module reads it at runtime — the dataclasses are the live source of defaults.",
