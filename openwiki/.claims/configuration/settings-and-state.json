    {
      "id": "claim_6cb62cc825b143e0be84936acd78ab67",
      "statement": "_validate_settings clamps every numeric field on each load and save: scale_factor [0.01, 1], source_type restricted to 'screen'/'window', fps [1, 60], transition_time_ms [0, 1000], brightness_scale [0, 2], gamma [0.1, 3], smoothing_factor [0.1, 1], zone rows/cols [1, 64], black-bar threshold [0, 50], detection_rate [1, 120], smooth_factor [0.1, 1], reading color_xy clamped to [0, 1] per coordinate or reset to (0.5, 0.4), and reading brightness [0, 254].",
