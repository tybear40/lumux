  "claims": [
    {
      "id": "claim_f4c3b995758241448c3d02983be9b552",
      "statement": "SyncController is a thin orchestrator holding references to HueBridge, ScreenCapture, ZoneProcessor, ColorAnalyzer, ZoneMapping, settings, and an optional EntertainmentStream. Its thread state is a running flag, a daemon threading.Thread named SyncLoop, a previous-colors dict, a queue.Queue(maxsize=100) status channel, a threading.Lock, a zone-to-channel map, and a stats dict seeded with fps=0, frame_count=0, errors=0, last_update.",
      "evidence": [
        {
          "resource": "repo://src/lumux/sync.py#L18-L55",
          "version": "repo-lines-v1:sha256:c10315719a23240ded683f309d1f4037ed55f14d28a8a681060efc58f6eb524c:"
        }
      ]
    },
    {
      "id": "claim_1340ef2b1dbd4e168752c066230b8962",
      "statement": "start() is a no-op if already running; it logs whether an EntertainmentStream exists and is connected, builds the zone-to-channel mapping only when the stream is connected (an unconnected stream leaves an empty map with a warning), then sets running=True and spawns the daemon SyncLoop thread.",
      "evidence": [
        {
          "resource": "repo://src/lumux/sync.py#L59-L83",
          "version": "repo-lines-v1:sha256:9bbd4ade839547e90be5590d878354e5d34e0ad8d76045e033315f6a14b34e53:"
        }
      ]
    },
    {
      "id": "claim_a733e3c30ee84d3ba18f8c6856b24e73",
      "statement": "_build_zone_channel_mapping() generates ambilight zone ids (top_0..top_{cols-1} and bottom_0..bottom_{cols-1} using the zone grid column count; left_0..left_{rows//2-1} and right_0..right_{rows//2-1} using half the row count) and maps each to the entertainment channel with the nearest reported position: _find_best_channel_for_zone() converts the zone edge and index to a target point in the entertainment coordinate space (x: -1 left to +1 right; z: -1 bottom to +1 top) and picks the channel minimizing squared distance.",
      "evidence": [
        {
          "resource": "repo://src/lumux/sync.py#L85-L179",
          "version": "repo-lines-v1:sha256:e00c1a3bb53d61bfaec8ddfa324fc13a1f60a20ed999b8d96dc80763c7f32140:"
        }
      ]
    },
    {
      "id": "claim_5a512bc1487c413a8f99ad6a4de641f7",
      "statement": "_sync_loop runs while running: it times one _process_frame() call, clamps the configured settings.fps into 1-60 (falling back to 30 on a bad value), sleeps max(0, 1/fps_target - elapsed), and computes the reported real fps as 1 over the mean of the last 30 total loop times (including sleep). Any non-KeyboardInterrupt exception increments stats errors, queues an 'error' status, and sleeps 1 s; KeyboardInterrupt breaks the loop, which then queues ('status', 'stopped').",
      "evidence": [
        {
          "resource": "repo://src/lumux/sync.py#L208-L253",
          "version": "repo-lines-v1:sha256:8ac3de767e8e60918f1471a781f32c05ea6c91d75258eabc03b1875e0144f635:"
        }
      ]
    },
    {
      "id": "claim_608ead3d469a4af28d4b58a8d6e90723",
      "statement": "stop() shuts down in a fixed order: running=False; thread.join(timeout=3) with a warning if the thread is still alive; capture.stop_pipeline() to release the portal session; then the optional _on_stop_callback() in a try/except, which AppContext uses for auto-switching into reading mode after a manual stop.",
      "evidence": [
        {
          "resource": "repo://src/lumux/sync.py#L181-L202",
          "version": "repo-lines-v1:sha256:a530db5dfed838ac3483cdbd1cd6459ea7c5fda46145f0f4a363c4ef1cbd32ae:"
        }
      ]
    },
    {
      "id": "claim_b6bfd6a7d39040709eb11aba871aef5b",
      "statement": "_process_frame() times five stages — capture.capture(), zone_processor.process_image(), color_analyzer.analyze_zones_batch(), color_analyzer.apply_smoothing(settings.smoothing_factor), and _update_lights() — bailing early on None or empty results without counting an error, and records the rounded per-stage seconds (capture/zones/analyze/smooth/update/total) into _stats['last_stage_times'] under the lock; it then queues the RGB zone colors (not XY) to the GUI as the zone-preview payload. _queue_status uses put_nowait and drops on queue.Full so the pipeline never blocks on a slow UI; get_status returns the next queued item or None.",
      "evidence": [
