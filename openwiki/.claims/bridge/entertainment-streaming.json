        }
      ]
    },
    {
      "id": "claim_5abf1a5a6f3a4d42b1b998ea1f6417ac",
      "statement": "map_zone_to_channel is a self-contained edge-based mapping — matching position ranges (top z∈[0.5,1], bottom z∈[−1,−0.5], left x∈[−1,−0.5], right x∈[0.5,1]), sorting candidates along the edge axis, and picking by clamped index — but as of this snapshot no caller outside the module invokes it; the sync engine implements its own nearest-position mapping instead.",
      "evidence": [
        {
          "resource": "repo://src/lumux/entertainment.py#L501-L540",
          "version": "repo-lines-v1:sha256:9784a5b9de04a0f7603df3fcc0953e57e53211788fade9b19421efbd1b9091ea:"
        }
      ]
    },
    {
      "id": "claim_00345a57a6d84f46b6abaec0a84806d5",
      "statement": "disconnect(bridge) clears _connected, cleans up the subprocess (close stdin → terminate → wait(timeout=2) → kill on timeout), then issues the REST deactivation; AppContext.stop_entertainment only calls disconnect when is_connected() is true, and AppContext.start_entertainment requires bridge.test_connection() to pass before attempting connect.",
