          "version": "repo-lines-v1:sha256:945e3a31c6fd893ead3ba6ab859f2fd293daced3be7723814628c7e13150c474:"
        }
      ]
    },
    {
      "id": "claim_35a15357c6614b7db5c5686e8c63fc6b",
      "statement": "Each entertainment configuration channel entry becomes a ChannelInfo (channel ID, 3D position, member list), and every member's service.rid is indexed into the light_to_channel dict as the reverse light→channel lookup.",
      "evidence": [
        {
          "resource": "repo://src/lumux/entertainment.py#L192-L253",
          "version": "repo-lines-v1:sha256:21605196da81beac89a6ab3626951fa18cc337189f4df7a15113bbe7e8646a8d:"
        }
      ]
    },
    {
      "id": "claim_fc00073e43144cbbb9d77e317a0587ae",
      "statement": "get_channel_positions() exposes the configuration's per-channel normalized {x, y, z} positions, and SyncController consumes this mapping (sync.py) for its zone→channel mapping.",
      "evidence": [
        {
          "resource": "repo://src/lumux/entertainment.py#L485-L499",
          "version": "repo-lines-v1:sha256:780c8c213d42328b84acf50f0e09a5c93e7cc3e12d97f59aa53cd0d9690f2c18:"
