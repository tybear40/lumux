    {
      "id": "claim_9d629869ce2a4502ab8df2218c555105",
      "statement": "_request maps failures onto a three-class hierarchy rooted at BridgeError: HTTP 401/403 → BridgeAuthError, HTTP 404 → BridgeError, HTTP ≥500 → BridgeConnectionError, requests timeout/connection error → BridgeConnectionError, any other RequestException → BridgeError.",
